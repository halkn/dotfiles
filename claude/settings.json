{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "30000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch -v*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git worktree list*)",
      "Bash(git stash list*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr status*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(gh search *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv tree *)",
      "Bash(uv lock --check *)",
      "Bash(uv audit *)",
      "Bash(uv export *)",
      "Bash(mise tasks*)",
      "Bash(mise task info*)",
      "Bash(eza *)",
      "Bash(tree *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(az repos list *)",
      "Bash(az repos show *)",
      "Bash(az repos pr list *)",
      "Bash(az repos pr show *)",
      "Bash(az pipelines list *)",
      "Bash(az pipelines show *)",
      "Bash(az pipelines runs list *)",
      "Bash(az pipelines runs show *)",
      "Bash(az boards work-item show *)",
      "Bash(az boards query *)",
      "Bash(az devops project list *)",
      "Bash(az devops project show *)",
      "Bash(az devops configure --list*)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:docs.microsoft.com)",
      "WebFetch(domain:azure.microsoft.com)",
      "WebFetch(domain:docs.snowflake.com)",
      "WebFetch(domain:community.snowflake.com)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/.ssh/**)",
      "Bash(dd*)",
      "Bash(shred*)",
      "Bash(truncate*)",
      "Bash(chmod -R*)",
      "Bash(chown -R*)",
      "Bash(crontab*)",
      "Bash(sudo*)",
      "Bash(nc *)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(git checkout*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git config *alias.*)",
      "Bash(uv publish*)",
      "Bash(az devops invoke *--http-method post*)",
      "Bash(az devops invoke *--http-method POST*)",
      "Bash(az devops invoke *--http-method patch*)",
      "Bash(az devops invoke *--http-method PATCH*)",
      "Bash(az devops invoke *--http-method put*)",
      "Bash(az devops invoke *--http-method PUT*)",
      "Bash(az devops invoke *--http-method delete*)",
      "Bash(az devops invoke *--http-method DELETE*)",
      "Bash(az devops invoke *--http-method=*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove*)",
      "Bash(git stash drop*)",
      "Bash(uv version*)",
      "Bash(uv self update*)",
      "Bash(uv tool uninstall*)",
      "Bash(uv python uninstall*)",
      "Bash(uv cache clean*)",
      "Bash(uv cache prune*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=~/.claude/hooks/block-secret-read.sh; [ -x \"$h\" ] || { echo \"PreToolUse hook missing: $h\" >&2; exit 2; }; exec \"$h\""
          },
          {
            "type": "command",
            "command": "h=~/.claude/hooks/block-main-push.sh; [ -x \"$h\" ] || { echo \"PreToolUse hook missing: $h\" >&2; exit 2; }; exec \"$h\""
          },
          {
            "type": "command",
            "command": "h=~/.claude/hooks/scope-gh-pr-create.sh; [ -x \"$h\" ] || { echo \"PreToolUse hook missing: $h\" >&2; exit 2; }; exec \"$h\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    }
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ast-grep@ast-grep-marketplace": true
  },
  "language": "japanese",
  "disableRemoteControl": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "dev.azure.com",
        "*.dev.azure.com",
        "*.vssps.visualstudio.com",
        "login.microsoftonline.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.azure",
        "~/.cache/uv",
        "~/.cache/mise",
        "~/.cache/rumdl",
        "~/.cache/shuck",
        "~/.local/share/uv",
        "~/.local/share/mise",
        "~/.local/state/mise"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.gnupg",
        "~/repos/github.com/halkn/dotfiles/claude"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        ".",
        "~/.azure",
        "~/.claude/skills",
        "~/.config",
        "~/repos/github.com/halkn/dotfiles/.config",
        "~/.cache/uv",
        "~/.cache/mise",
        "~/.cache/rumdl",
        "~/.cache/shuck",
        "~/.local/share/uv",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.local/bin"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/repos/github.com/halkn/dotfiles/.config/gh",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AZURE_CLIENT_SECRET",
          "mode": "deny"
        },
        {
          "name": "AZURE_DEVOPS_EXT_PAT",
          "mode": "deny"
        },
        {
          "name": "SNOWFLAKE_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "SNOWFLAKE_PRIVATE_KEY",
          "mode": "deny"
        },
        {
          "name": "SNOWFLAKE_PRIVATE_KEY_PASSPHRASE",
          "mode": "deny"
        },
        {
          "name": "SNOWSQL_PWD",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "git push",
      "git push *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git clone *",
      "git ls-remote *",
      "git remote update*",
      "git remote prune*",
      "git submodule *",
      "gh *"
    ]
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoMode": {
    "environment": [
      "$defaults",
      "Two distinct contexts share this configuration: personal projects and employer business work. Infer which one applies from the repository remote and the working directory; never assume the personal context by default. In the business context, treat internal hosts, data, identifiers, and source code as confidential, and do not rely on this file's statements as evidence that no sensitive infrastructure exists. This file is public, so trusted business infrastructure is declared in managed settings, not here.",
      "Primary use of Claude Code: dotfiles and CLI/editor configuration management, plus data engineering (Snowflake/SQL) and Python tooling with uv.",
      "Source control: personal work lives under github.com/halkn; business work lives in separate remotes. Never push, mirror, or copy content from a repository of one context into a remote of the other, and do not add a cross-context remote.",
      "Repository visibility: github.com/halkn/dotfiles is a public repository whose own subject matter is personal shell, editor, and CLI configuration. Other repositories default to private unless stated otherwise in the conversation.",
      "Internal sharing / snippet hosting: none configured. Do not send content to public paste or gist services.",
      "Secrets management: credentials live in the OS keychain and in CLI token caches, never in tracked files. Machine-local secrets live in untracked *.local files. None of these belong in a commit, PR, or issue.",
      "Sensitive data locations & audiences: SSH and GPG key directories, cloud and CLI credential stores, Claude Code session transcripts, and any .env or *.local file. Contents of these locations must not be copied into commits, pull requests, issues, or any outbound request.",
      "Network posture: untrusted network. Assume no network-level trust boundary protects this machine."
    ],
    "classifyAllShell": true
  }
}

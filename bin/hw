#!/usr/bin/env zsh
# hw - herdr workspaces on the clones and worktrees of this machine: opening
# one on a clone, a branch or a pull request, removing it again, and the rows
# the pickers and completions show.
#
# This is the only file that talks to herdr. The judgement stays with git, gh,
# az and herdr themselves; what is ours is where a worktree lands, how their
# arguments are put together, and the rows. Nothing here opens a picker or asks
# a question - every subcommand runs on its arguments alone. The layout:
#
#   $WT_ROOT/<owner>/<repo>/<branch, with / folded to ->

set -uo pipefail

_hw_usage() {
  cat <<'USAGE'
usage: hw <command> [<args>]

  repo <spec|path>                open a workspace on the clone (`repo get` first)
  branch <name> [<base>]          create or reuse its worktree and open it
  pr <number>                     the same for a pull request (GitHub or Azure DevOps)
  rm [-f] <branch|path|id>...     remove worktrees, close their workspaces, delete merged branches
  close <id>...                   close workspaces only
  branches                        rows for the branch picker and completion
  prs                             rows for the pull request picker and completion
  spaces                          rows for the clean-up picker (workspaces, then idle worktrees)
  list                            rows of every worktree under $WT_ROOT
  focused                         the checkout of the focused workspace
  root                            print $WT_ROOT

Opening a workspace that is already open focuses it instead. rm refuses a
worktree with local changes or a running process in one of its panes; -f
removes it anyway. A branch is deleted when git or a merge-tree check says it
is in origin's default branch, and kept otherwise.
USAGE
}

_hw_require() {
  command -v "$1" >/dev/null 2>&1 || {
    print -u2 "hw: $1 is not installed"
    return 1
  }
}

# ── layout ───────────────────────────────────────────

# The default matches herdr's own `[worktrees] directory`; change both together.
_hw_root() {
  local root=${WT_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/worktrees}
  root=${root/#\~/$HOME}
  print -r -- "${root%/}"
}

# The checkout every worktree of the repository hangs off. `git worktree list`
# always names it first, whichever worktree git is asked from.
_hw_main() {
  local dir=${1:-.} line
  line=$(git -C "$dir" worktree list --porcelain 2>/dev/null) || {
    print -u2 'hw: not inside a git repository'
    return 1
  }
  line=${${(f)line}[1]}
  print -r -- "${line#worktree }"
}

# Read off the main checkout's path rather than the remote URL, so a repository
# with no remote still lands somewhere predictable. A branch name is one path
# segment; two branches differing only in `/` share a directory, and that
# collision is accepted rather than encoded.
_hw_path() {
  local main=$1 branch=$2
  print -r -- "$(_hw_root)/${${main:h}:t}/${main:t}/${branch//\//-}"
}

# Only a directory of the layout under $WT_ROOT is taken, which keeps out the
# main checkout and Claude Code's .claude/worktrees (its lifecycle; an agent may
# still be running there). The one thing git removes without complaint is the
# worktree the caller stands in, so that is refused here as well.
_hw_removable() {
  local wt_path=$1 root resolved=${1:A}
  root=${${:-$(_hw_root)}:A}
  if [[ $resolved != "$root"/*/*/* || $resolved == "$root"/*/*/*/* ]]; then
    print -u2 "hw: not a worktree under $root: $wt_path"
    return 1
  fi
  if [[ ${PWD:A} == "$resolved" || ${PWD:A} == "$resolved"/* ]]; then
    print -u2 "hw: cannot remove the worktree you are standing in: $wt_path"
    return 1
  fi
  [[ -d $wt_path ]] || {
    print -u2 "hw: no such worktree: $wt_path"
    return 1
  }
}

# ── herdr ────────────────────────────────────────────

# `<id>\t<number>\t<label>\t<checkout path>\t<focused>` per open workspace. A
# workspace off a checkout, or one opened with `workspace create` on a worktree,
# has no checkout path (herdr 0.9.5).
_hw_workspaces() {
  local out
  out=$(herdr workspace list) || {
    print -u2 'hw: herdr could not list the workspaces'
    return 1
  }
  print -r -- "$out" | jq -r '
    .result.workspaces[]?
    | [.workspace_id, (.number | tostring), .label,
       (.worktree.checkout_path // ""), (.focused | tostring)]
    | @tsv
  '
}

# `<pane id>\t<cwd>` per pane of a workspace.
_hw_panes() {
  local out
  out=$(herdr pane list --workspace "$1") || return 1
  print -r -- "$out" | jq -r '.result.panes[]? | [.pane_id, .cwd] | @tsv'
}

# What a pane runs in front of its shell, empty when the shell itself has the
# terminal. Read off the process group rather than the name, which differs
# between a login shell (-zsh) and any other.
_hw_busy() {
  local out
  out=$(herdr pane process-info --pane "$1") || return 1
  print -r -- "$out" | jq -r '
    .result.process_info
    | select(.foreground_process_group_id != .shell_pid)
    | [.foreground_processes[]?.cmdline] | join(", ")
  '
}

# herdr answers a refusal as JSON on stdout; the message is what a person reads.
_hw_herdr_error() {
  local out=$1 msg
  msg=$(print -r -- "$out" | jq -r '.error.message? // empty' 2>/dev/null) || msg=
  print -u2 -r -- "hw: ${msg:-$out}"
}

# `worktree open` rather than `workspace create`: only the former records the
# repository, which is what groups the workspace under its clone, and it
# focuses a workspace already open on the path instead of adding a second one
# (herdr 0.9.5).
_hw_open_worktree() {
  local main=$1 wt_path=$2 out
  out=$(herdr worktree open --cwd "$main" --path "$wt_path" --focus 2>&1) || {
    _hw_herdr_error "$out"
    return 1
  }
}

# ── worktrees ────────────────────────────────────────

# An existing directory is handed back only when it holds the branch asked for:
# `/` folds to `-`, so another branch may be sitting there. With $3 set, a
# branch qualified by an owner also counts, as gh names a fork's head that way.
_hw_reuse() {
  local wt_path=$1 branch=$2 held
  local -i qualified=${3:-0}
  held=$(git -C "$wt_path" symbolic-ref --short -q HEAD)
  [[ $held == "$branch" ]] || { ((qualified)) && [[ $held == */"$branch" ]]; } || {
    print -u2 "hw: $wt_path holds ${held:-a detached HEAD}, not $branch"
    return 1
  }
}

# With no base, a branch is picked up where it already is - locally, then on
# origin - so one that exists only on the remote is tracked instead of silently
# forked; herdr's own `worktree create` forks it from HEAD (herdr 0.9.5). When
# origin cannot be reached, what the last fetch knew of it still counts. A base
# always means a new branch, and fails if it already exists. With $4 set, the
# branch has to come from origin, as a pull request's head does.
_hw_add() {
  local main=$1 branch=$2 base=$3 wt_path
  local -i remote=${4:-0}
  wt_path=$(_hw_path "$main" "$branch")
  if [[ -d $wt_path ]]; then
    [[ -z $base ]] || {
      print -u2 "hw: $wt_path already exists, so <base> cannot apply"
      return 1
    }
    _hw_reuse "$wt_path" "$branch" || return 1
  elif [[ -n $base ]]; then
    git -C "$main" worktree add -b "$branch" "$wt_path" "$base" >&2 || return 1
  elif git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$wt_path" "$branch" >&2 || return 1
  else
    if ! git -C "$main" fetch -q origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" 2>/dev/null; then
      ((remote)) && {
        print -u2 "hw: could not fetch $branch from origin"
        return 1
      }
      print -u2 "hw: could not fetch $branch from origin; using what is known of it"
    fi
    if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$main" worktree add --track -b "$branch" "$wt_path" "origin/$branch" >&2 || return 1
    else
      # Forked from the checkout the caller stands in, not the main one.
      git -C "$main" worktree add -b "$branch" "$wt_path" "$(git rev-parse HEAD)" >&2 || return 1
    fi
  fi
  print -r -- "$wt_path"
}

# What `git branch -d` cannot see: a squash merge leaves no commit of the branch
# in the default branch, but merging the branch into it then changes nothing.
_hw_squashed() {
  local main=$1 branch=$2 tree
  tree=$(git -C "$main" merge-tree --write-tree refs/remotes/origin/HEAD "refs/heads/$branch" 2>/dev/null) ||
    return 1
  [[ $tree == "$(git -C "$main" rev-parse 'refs/remotes/origin/HEAD^{tree}' 2>/dev/null)" ]]
}

# The worktree goes first and its branch only after; the default branch stays.
_hw_drop_branch() {
  local main=$1 branch=$2 default
  [[ -n $branch ]] || return 0
  default=$(git -C "$main" symbolic-ref --short -q refs/remotes/origin/HEAD)
  [[ $branch != "${default#origin/}" ]] || return 0
  git -C "$main" branch -d -q -- "$branch" 2>/dev/null && return 0
  if _hw_squashed "$main" "$branch"; then
    git -C "$main" branch -D -q -- "$branch" >&2
    return
  fi
  print -u2 "hw: kept the branch $branch, which is not merged into ${default:-the default branch}"
}

# A target is a path, an open workspace's id, or a branch of the repository
# here, tried in that order.
_hw_resolve() {
  local arg=$1 row main
  local -a f
  if [[ $arg == */* && -d $arg ]]; then
    print -r -- "${arg:A}"
    return 0
  fi
  for row in ${(f)"$(_hw_workspaces 2>/dev/null)"}; do
    f=("${(@ps:\t:)row}")
    [[ ${f[1]} == "$arg" && -n ${f[4]-} ]] || continue
    print -r -- "${f[4]:A}"
    return 0
  done
  main=$(_hw_main) || return 1
  _hw_path "$main" "$arg"
}

# One worktree: every workspace standing on it - by its checkout, or by a pane
# inside it - is checked for running processes, then the worktree is removed
# and the workspaces closed. herdr's `worktree remove` closes only the workspace
# that carries the checkout and removes regardless of what runs in it (herdr
# 0.9.5), so the rest is ours.
_hw_rm_one() {
  local wt_path=$1 main branch row ws carrier= pane cwd busy out
  local -i force=$2 rc=0
  local -a f p on
  main=$(_hw_main "$wt_path") || return 1
  branch=$(git -C "$wt_path" symbolic-ref --short -q HEAD)

  # Without the list nothing can be checked for running processes.
  out=$(_hw_workspaces) || return 1
  for row in ${(f)out}; do
    f=("${(@ps:\t:)row}")
    ws=${f[1]}
    if [[ -n ${f[4]-} && ${f[4]:A} == "$wt_path" ]]; then
      on+=("$ws")
      carrier=$ws
      continue
    fi
    for pane in ${(f)"$(_hw_panes "$ws")"}; do
      p=("${(@ps:\t:)pane}")
      cwd=${p[2]-}
      [[ -n $cwd && (${cwd:A} == "$wt_path" || ${cwd:A} == "$wt_path"/*) ]] || continue
      on+=("$ws")
      break
    done
  done

  if ((!force)); then
    for ws in "${on[@]}"; do
      for pane in ${(f)"$(_hw_panes "$ws")"}; do
        p=("${(@ps:\t:)pane}")
        busy=$(_hw_busy "${p[1]}") || return 1
        [[ -z $busy ]] && continue
        print -u2 -r -- "hw: ${p[1]} is running $busy; -f removes $wt_path anyway"
        return 1
      done
    done
  fi

  local -a flags
  ((force)) && flags=(--force)
  if [[ -n $carrier ]]; then
    out=$(herdr worktree remove --workspace "$carrier" "${flags[@]}" 2>&1) || {
      _hw_herdr_error "$out"
      return 1
    }
  else
    git -C "$main" worktree remove "${flags[@]}" -- "$wt_path" >&2 || return
  fi
  rmdir -- "${wt_path:h}" 2>/dev/null

  for ws in "${on[@]}"; do
    [[ $ws != "$carrier" ]] || continue
    herdr workspace close "$ws" >/dev/null || {
      print -u2 "hw: herdr could not close $ws"
      rc=1
    }
  done
  _hw_drop_branch "$main" "$branch"
  return $rc
}

# ── commands ─────────────────────────────────────────

_hw_cmd_repo() {
  local spec=${1:-} dir row out
  local -a f
  [[ -n $spec ]] || {
    print -u2 'usage: hw repo <spec|path>'
    return 1
  }
  if [[ -e $spec/.git ]]; then
    dir=${spec:A}
  else
    _hw_require repo || return 1
    dir=$(repo get "$spec") || return
  fi
  for row in ${(f)"$(_hw_workspaces)"}; do
    f=("${(@ps:\t:)row}")
    [[ -n ${f[4]-} && ${f[4]:A} == "${dir:A}" ]] || continue
    herdr workspace focus "${f[1]}" >/dev/null
    return
  done
  out=$(herdr workspace create --cwd "$dir" --focus 2>&1) || {
    _hw_herdr_error "$out"
    return 1
  }
}

_hw_cmd_branch() {
  local branch=${1:-} base=${2:-} main wt_path
  [[ -n $branch ]] || {
    print -u2 'usage: hw branch <name> [<base>]'
    return 1
  }
  main=$(_hw_main) || return 1
  wt_path=$(_hw_add "$main" "$branch" "$base") || return 1
  _hw_open_worktree "$main" "$wt_path"
}

# The host is read off origin's URL.
_hw_host() {
  local url
  # The configured URL, before any insteadOf rewrites it.
  url=$(git config --get remote.origin.url) || {
    print -u2 'hw: this repository has no origin'
    return 1
  }
  case $url in
    *github.com[:/]*)
      print github
      ;;
    *dev.azure.com[:/]* | *.visualstudio.com[:/]* | *ssh.dev.azure.com[:/]*)
      print azure
      ;;
    *)
      print -u2 "hw: origin is neither GitHub nor Azure DevOps: $url"
      return 1
      ;;
  esac
}

# On GitHub, `gh pr checkout` is the only thing that gets a fork's head right,
# so gh adds the worktree and names its branch; a fork qualifies the local
# branch by owner when its head is the default branch. On Azure DevOps the head
# is fetched from origin, so a pull request from a fork is not reached.
_hw_cmd_pr() {
  local number=${1:-} host main branch wt_path
  number=${number#\#}
  [[ -n $number ]] || {
    print -u2 'usage: hw pr <number>'
    return 1
  }
  main=$(_hw_main) || return 1
  host=$(_hw_host) || return 1
  case $host in
    github)
      _hw_require gh || return 1
      branch=$(gh pr view "$number" --json headRefName --jq '.headRefName') || return
      [[ -n $branch ]] || {
        print -u2 "hw: could not resolve the head branch of #$number"
        return 1
      }
      wt_path=$(_hw_path "$main" "$branch")
      if [[ -d $wt_path ]]; then
        _hw_reuse "$wt_path" "$branch" 1 || return 1
      else
        gh pr checkout "$number" --worktree "$wt_path" >&2 || {
          [[ ! -d $wt_path ]] || git -C "$main" worktree remove --force -- "$wt_path" >&2
          rmdir -- "${wt_path:h}" 2>/dev/null
          return 1
        }
      fi
      ;;
    azure)
      _hw_require az || return 1
      branch=$(az repos pr show --id "$number" --query sourceRefName --output tsv) || return
      branch=${branch#refs/heads/}
      [[ -n $branch ]] || {
        print -u2 "hw: could not resolve the source branch of !$number"
        return 1
      }
      wt_path=$(_hw_add "$main" "$branch" '' 1) || return 1
      ;;
  esac
  _hw_open_worktree "$main" "$wt_path"
}

# Every target is attempted, and the status is the last refusal's.
_hw_cmd_rm() {
  local arg wt_path
  local -i force=0 rc=0 st
  local -a targets
  for arg in "$@"; do
    case $arg in
      -f | --force)
        force=1
        ;;
      -h | --help)
        print -r -- 'usage: hw rm [-f] <branch|path|id>...'
        return 0
        ;;
      -*)
        print -u2 "hw rm: unknown option: $arg"
        return 1
        ;;
      *)
        targets+=("$arg")
        ;;
    esac
  done
  ((${#targets} > 0)) || {
    print -u2 'usage: hw rm [-f] <branch|path|id>...'
    return 1
  }
  for arg in "${targets[@]}"; do
    st=0
    wt_path=$(_hw_resolve "$arg") || {
      rc=1
      continue
    }
    _hw_removable "$wt_path" || {
      rc=1
      continue
    }
    _hw_rm_one "${wt_path:A}" "$force" || st=$?
    ((st == 0)) || rc=$st
  done
  return $rc
}

_hw_cmd_close() {
  local ws
  local -i rc=0
  (($# > 0)) || {
    print -u2 'usage: hw close <id>...'
    return 1
  }
  for ws in "$@"; do
    herdr workspace close "$ws" >/dev/null || {
      print -u2 "hw: herdr could not close $ws"
      rc=1
    }
  done
  return $rc
}

# `<display>\t<branch>`: the branches checked out in a worktree, then the other
# local ones, then those only origin has, each most recent first.
_hw_cmd_branches() {
  local main line b
  local -A held seen
  main=$(_hw_main) || return 1
  for line in ${(f)"$(git -C "$main" worktree list --porcelain)"}; do
    [[ $line == 'branch refs/heads/'* ]] && held[${line#branch refs/heads/}]=1
  done
  {
    for b in ${(f)"$(git -C "$main" for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads)"}; do
      seen[$b]=1
      ((${+held[$b]})) && printf '0\t%-8s %s\t%s\n' worktree "$b" "$b"
      ((${+held[$b]})) || printf '1\t%-8s %s\t%s\n' local "$b" "$b"
    done
    for b in ${(f)"$(git -C "$main" for-each-ref --sort=-committerdate --format='%(refname:lstrip=3)' refs/remotes/origin)"}; do
      [[ $b == HEAD || -n ${seen[$b]-} ]] && continue
      printf '2\t%-8s %s\t%s\n' origin "$b" "$b"
    done
  } | sort -s -t $'\t' -k1,1 | cut -f2-
}

# `<display>\t<number>` per open pull request.
_hw_cmd_prs() {
  local host row
  local -a f
  _hw_main >/dev/null || return 1
  host=$(_hw_host) || return 1
  case $host in
    github)
      _hw_require gh || return 1
      gh pr list --limit 100 --json number,title,author \
        --jq '.[] | "#\(.number)  \(.title)  (\(.author.login))\t\(.number)"'
      ;;
    azure)
      _hw_require az || return 1
      row=$(az repos pr list --status active --top 100 \
        --query '[].[pullRequestId, title, createdBy.displayName]' --output tsv) || return
      for row in ${(f)row}; do
        f=("${(@ps:\t:)row}")
        printf '!%s  %s  (%s)\t%s\n' "${f[1]}" "${f[2]-}" "${f[3]-}" "${f[1]}"
      done
      ;;
  esac
}

# `<display>\t<subcommand>\t<argument>\t<directory>` per open workspace other
# than the focused one, whose shells the picker was opened from, and per
# worktree under the root with no workspace. A worktree is removed by its path,
# once however many workspaces stand on it; any other workspace is only closed,
# so a clone is never deleted from here.
_hw_cmd_spaces() {
  local rows row root dir branch shown focused=${HERDR_ACTIVE_WORKSPACE_ID:-}
  local -a f
  local -A listed
  root=${${:-$(_hw_root)}:A}
  rows=$(_hw_workspaces) || return 1
  # The focused worktree is left out whichever workspace stands on it.
  for row in ${(f)rows}; do
    f=("${(@ps:\t:)row}")
    [[ ${f[1]} == "$focused" || (-z $focused && ${f[5]-} == true) ]] || continue
    [[ -z ${f[4]-} ]] || listed[${f[4]:A}]=1
  done
  for row in ${(f)rows}; do
    f=("${(@ps:\t:)row}")
    [[ ${f[1]} == "$focused" || (-z $focused && ${f[5]-} == true) ]] && continue
    dir=${f[4]-}
    [[ -z $dir ]] || dir=${dir:A}
    if [[ $dir == "$root"/*/*/* && $dir != "$root"/*/*/*/* ]]; then
      [[ -z ${listed[$dir]-} ]] || continue
      listed[$dir]=1
      branch=$(git -C "$dir" symbolic-ref --short -q HEAD) || branch=${dir:t}
      printf '[%s] %s %s\t%s\t%s\t%s\n' "${f[2]}" "${${dir#"$root"/}%/*}" "$branch" rm "$dir" "$dir"
    else
      shown=${${dir/#$HOME/'~'}:-${f[3]}}
      printf '[%s] %s\t%s\t%s\t%s\n' "${f[2]}" "$shown" close "${f[1]}" "$dir"
    fi
  done
  # Then the worktrees no workspace stands on, which nothing else lists.
  for dir in "$root"/*/*/*(N/); do
    [[ -z ${listed[$dir]-} ]] || continue
    branch=$(git -C "$dir" symbolic-ref --short -q HEAD) || branch=${dir:t}
    printf '[-] %s %s\t%s\t%s\t%s\n' "${${dir#"$root"/}%/*}" "$branch" rm "$dir" "$dir"
  done
}

# `<owner>/<repo> <branch>\t<path>` per worktree under the root, read off the
# layout rather than herdr, so it works outside herdr too.
_hw_cmd_list() {
  local root dir branch
  root=${${:-$(_hw_root)}:A}
  for dir in "$root"/*/*/*(N/); do
    branch=$(git -C "$dir" symbolic-ref --short -q HEAD) || branch=${dir:t}
    printf '%s %s\t%s\n' "${${dir#"$root"/}%/*}" "$branch" "$dir"
  done
}

# The workspace herdr ran the command over, by the id it hands a custom
# command; the pane's cwd only stands in for a workspace off a checkout, as it
# moves with every `cd` in that pane.
_hw_cmd_focused() {
  local row ws=${HERDR_ACTIVE_WORKSPACE_ID:-}
  local -a f
  for row in ${(f)"$(_hw_workspaces)"}; do
    f=("${(@ps:\t:)row}")
    [[ ${f[1]} == "$ws" || (-z $ws && ${f[5]-} == true) ]] || continue
    if [[ -n ${f[4]-} ]]; then
      print -r -- "${f[4]}"
      return 0
    fi
    break
  done
  [[ -n ${HERDR_ACTIVE_PANE_CWD:-} ]] || {
    print -u2 'hw: the focused workspace has no checkout'
    return 1
  }
  print -r -- "$HERDR_ACTIVE_PANE_CWD"
}

# ── dispatch ─────────────────────────────────────────

cmd=${1:-}
(($# == 0)) || shift
case $cmd in
  root)
    _hw_root
    exit
    ;;
  -h | --help | help)
    _hw_usage
    exit
    ;;
  '')
    _hw_usage >&2
    exit 1
    ;;
esac

case $cmd in
  repo | branch | pr | rm | close | spaces | focused)
    _hw_require herdr || exit 1
    _hw_require jq || exit 1
    ;;
esac

case $cmd in
  repo)
    _hw_cmd_repo "$@"
    ;;
  branch)
    _hw_cmd_branch "$@"
    ;;
  pr)
    _hw_cmd_pr "$@"
    ;;
  rm)
    _hw_cmd_rm "$@"
    ;;
  close)
    _hw_cmd_close "$@"
    ;;
  branches)
    _hw_cmd_branches "$@"
    ;;
  prs)
    _hw_cmd_prs "$@"
    ;;
  spaces)
    _hw_cmd_spaces "$@"
    ;;
  list)
    _hw_cmd_list "$@"
    ;;
  focused)
    _hw_cmd_focused "$@"
    ;;
  *)
    print -u2 "hw: unknown subcommand: $cmd"
    _hw_usage >&2
    exit 1
    ;;
esac

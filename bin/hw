#!/usr/bin/env zsh
# hw - herdr workspaces on the clones and worktrees of this machine: opening
# one on a clone, a branch or a pull request, removing it again, and the rows
# the pickers and completions show.
#
# This is the only file that talks to herdr. The judgement stays with git, gh,
# az and herdr themselves; what is ours is where a worktree lands, how their
# arguments are put together, and the rows. Nothing here opens a picker or asks
# a question - every subcommand runs on its arguments alone. The layout:
#
#   $WT_ROOT/<owner>/<repo>/<branch, with / folded to ->

set -uo pipefail

_hw_usage() {
  cat <<'USAGE'
usage: hw <command> [<args>]

  repo <spec|path>                open a workspace on the clone (`repo get` first)
  branch <name> [<base>]          create or reuse its worktree and open it
  pr <number>                     the same for a pull request (GitHub or Azure DevOps)
  rm [-f] <path|branch|id>...     remove worktrees, close their workspaces, delete merged branches
  close <id>...                   close workspaces only
  branches                        rows for the branch picker and completion
  prs                             rows for the pull request picker and completion
  spaces                          rows for the clean-up picker (workspaces, then idle worktrees)
  list                            rows of every worktree under $WT_ROOT
  focused                         the checkout of the focused workspace
  root                            print $WT_ROOT

Opening a workspace that is already open focuses it instead. rm refuses a
worktree with local changes or a running process in one of its panes; -f
removes it anyway. A branch is deleted when it is in origin's default branch,
squash merges included, and kept otherwise. Outside herdr, rm uses git alone.
USAGE
}

_hw_require() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || {
      print -u2 "hw: $tool is not installed"
      return 1
    }
  done
}

# ── layout ───────────────────────────────────────────

# The default matches herdr's own `[worktrees] directory`; change both together.
_hw_root() {
  local root=${WT_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/worktrees}
  root=${root/#\~/$HOME}
  print -r -- "${root%/}"
}

# The checkout every worktree of the repository hangs off. `git worktree list`
# always names it first, whichever worktree git is asked from.
_hw_main() {
  local dir=${1:-.} line
  line=$(git -C "$dir" worktree list --porcelain 2>/dev/null) || {
    print -u2 'hw: not inside a git repository'
    return 1
  }
  line=${${(f)line}[1]}
  print -r -- "${line#worktree }"
}

# Read off the main checkout's path rather than the remote URL, so a repository
# with no remote still lands somewhere predictable. A branch name is one path
# segment; two branches differing only in `/` share a directory, and that
# collision is accepted rather than encoded.
_hw_path() {
  local main=$1 branch=$2
  print -r -- "$(_hw_root)/${${main:h}:t}/${main:t}/${branch//\//-}"
}

# The worktree, wherever it is, that has the branch checked out, into REPLY.
_hw_checked_out() {
  local main=$1 branch=$2 line at=
  REPLY=
  for line in ${(f)"$(git -C "$main" worktree list --porcelain)"}; do
    case $line in
      'worktree '*)
        at=${line#worktree }
        ;;
      "branch refs/heads/$branch")
        REPLY=$at
        return 0
        ;;
    esac
  done
  return 1
}

# The branch a checkout is on, into REPLY: the name under refs/heads/, or the
# short hash of a detached HEAD. Read off the HEAD file because the rows run it
# once per worktree. A worktree's .git is a file naming its gitdir, relative to
# the worktree when not absolute.
_hw_head() {
  local dir=$1 gitdir=$1/.git head=
  REPLY=${1:t}
  if [[ -f $gitdir ]]; then
    read -r head <"$gitdir" || [[ -n $head ]] || return 1
    gitdir=${head#gitdir: }
    [[ $gitdir == /* ]] || gitdir=$dir/$gitdir
    head=
  fi
  [[ -r $gitdir/HEAD ]] || return 1
  read -r head <"$gitdir/HEAD" || [[ -n $head ]] || return 1
  if [[ $head == 'ref: refs/heads/'* ]]; then
    REPLY=${head#ref: refs/heads/}
  else
    REPLY=${head[1,7]}
  fi
}

# Exactly <owner>/<repo>/<branch> under the root, both already resolved.
_hw_in_layout() {
  [[ $1 == "$2"/*/*/* && $1 != "$2"/*/*/*/* ]]
}

# `<owner>/<repo> <branch>` of a worktree under the root, into REPLY.
_hw_label() {
  local dir=$1 root=$2
  _hw_head "$dir"
  REPLY="${${dir#"$root"/}%/*} $REPLY"
}

# The host is read off origin's URL as configured, before any insteadOf
# rewrites it.
_hw_host() {
  local url
  url=$(git config --get remote.origin.url) || {
    print -u2 'hw: this repository has no origin'
    return 1
  }
  case $url in
    *github.com[:/]*)
      print github
      ;;
    *dev.azure.com[:/]* | *.visualstudio.com[:/]* | *ssh.dev.azure.com[:/]*)
      print azure
      ;;
    *)
      print -u2 "hw: origin is neither GitHub nor Azure DevOps: $url"
      return 1
      ;;
  esac
}

# ── herdr ────────────────────────────────────────────

# The open workspaces, read once per invocation into parallel arrays indexed
# alike. A workspace off a checkout, or one opened with `workspace create` on a
# worktree, has an empty checkout path.
typeset -ga _HW_WS_ID _HW_WS_NUM _HW_WS_LABEL _HW_WS_PATH _HW_WS_FOCUSED
typeset -gi _HW_WS_READ=0
_hw_ws_load() {
  local out row
  local -a f
  ((_HW_WS_READ)) && return 0
  _hw_require herdr jq || return 1
  out=$(herdr workspace list) || {
    print -u2 'hw: herdr could not list the workspaces'
    return 1
  }
  out=$(print -r -- "$out" | jq -r '
    .result.workspaces[]?
    | [.workspace_id, (.number | tostring), .label,
       (.worktree.checkout_path // ""), (.focused | tostring)]
    | @tsv
  ') || return 1
  for row in ${(f)out}; do
    f=("${(@ps:\t:)row}")
    _HW_WS_ID+=("${f[1]}")
    _HW_WS_NUM+=("${f[2]-}")
    _HW_WS_LABEL+=("${f[3]-}")
    _HW_WS_PATH+=("${f[4]-}")
    _HW_WS_FOCUSED+=("${f[5]-}")
  done
  _HW_WS_READ=1
}

# Whether workspace $1 (an index into _HW_WS_*) is the one herdr ran the
# command over: the id it hands a custom command, else the one marked focused.
_hw_is_focused() {
  local -i i=$1
  if [[ -n ${HERDR_ACTIVE_WORKSPACE_ID:-} ]]; then
    [[ ${_HW_WS_ID[i]} == "$HERDR_ACTIVE_WORKSPACE_ID" ]]
  else
    [[ ${_HW_WS_FOCUSED[i]} == true ]]
  fi
}

# `<pane id>\t<cwd>` per pane of a workspace, into REPLY, read once per
# workspace.
typeset -gA _HW_PANES
_hw_panes() {
  local ws=$1 out
  if ((${+_HW_PANES[$ws]})); then
    REPLY=${_HW_PANES[$ws]}
    return 0
  fi
  if ! out=$(herdr pane list --workspace "$ws") ||
    ! REPLY=$(print -r -- "$out" | jq -r '.result.panes[]? | [.pane_id, .cwd] | @tsv'); then
    print -u2 "hw: herdr could not list the panes of $ws"
    return 1
  fi
  _HW_PANES[$ws]=$REPLY
}

# What a pane runs in front of its shell, into REPLY; empty when the shell
# itself has the terminal. Decided by the process group, not by the names, which
# herdr may not be able to read and which differ between a login shell (-zsh)
# and any other.
_hw_busy() {
  local out
  if ! out=$(herdr pane process-info --pane "$1") ||
    ! REPLY=$(print -r -- "$out" | jq -r '
      .result.process_info
      | select(.foreground_process_group_id != .shell_pid)
      | ([.foreground_processes[]?.cmdline // empty] | join(", ")) as $c
      | if $c == "" then "process group \(.foreground_process_group_id)" else $c end
    '); then
    print -u2 "hw: herdr could not tell what $1 runs"
    return 1
  fi
}

# A herdr command whose output is not wanted. herdr answers a refusal as JSON on
# stdout; the message is what a person reads.
_hw_herdr() {
  local out msg
  out=$(herdr "$@" 2>&1) && return 0
  msg=$(print -r -- "$out" | jq -r '.error.message? // empty' 2>/dev/null) || msg=
  print -u2 -r -- "hw: ${msg:-$out}"
  return 1
}

# A clone gets a workspace of its own, focused when one is already open on it. A
# worktree goes through `worktree open` rather than `workspace create`: only the
# former records the repository, which groups the workspace under its clone,
# and it focuses a workspace already open on the path.
_hw_open() {
  local dir=${1:A} main
  local -i i
  main=$(_hw_main "$dir") || return 1
  _hw_ws_load || return 1
  if [[ ${main:A} != "$dir" ]]; then
    _hw_herdr worktree open --cwd "$main" --path "$dir" --focus
    return
  fi
  for ((i = 1; i <= ${#_HW_WS_ID}; i++)); do
    [[ -n ${_HW_WS_PATH[i]} && ${_HW_WS_PATH[i]:A} == "$dir" ]] || continue
    _hw_herdr workspace focus "${_HW_WS_ID[i]}"
    return
  done
  _hw_herdr workspace create --cwd "$dir" --focus
}

# ── worktrees ────────────────────────────────────────

# Only the one branch, into its remote-tracking ref, even when origin's history
# rewrote it.
_hw_fetch() {
  local main=$1 branch=$2
  git -C "$main" fetch -q origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" 2>/dev/null
}

# An existing directory is handed back only when it holds the branch asked for:
# `/` folds to `-`, so another branch may be sitting there. With $3 set, a
# branch qualified by an owner also counts, as gh names a fork's head that way.
_hw_reuse() {
  local wt_path=$1 branch=$2 held
  local -i qualified=${3:-0}
  held=$(git -C "$wt_path" symbolic-ref --short -q HEAD)
  [[ $held == "$branch" ]] || { ((qualified)) && [[ $held == */"$branch" ]]; } || {
    print -u2 "hw: $wt_path holds ${held:-a detached HEAD}, not $branch"
    return 1
  }
}

# A pull request's head moves on after its worktree is made, so what is
# reopened is brought up to origin when that only moves it forward. A diverged
# or dirty one is left at its own tip, with a word.
_hw_forward() {
  local main=$1 branch=$2 at=${3:-}
  git -C "$main" merge-base --is-ancestor "refs/heads/$branch" "refs/remotes/origin/$branch" 2>/dev/null || {
    git -C "$main" merge-base --is-ancestor "refs/remotes/origin/$branch" "refs/heads/$branch" 2>/dev/null ||
      print -u2 "hw: $branch has diverged from origin; left at its own tip"
    return 0
  }
  if [[ -n $at ]]; then
    git -C "$at" merge --ff-only -q "refs/remotes/origin/$branch" >&2 ||
      print -u2 "hw: could not bring $at up to origin/$branch; left at its own tip"
  else
    git -C "$main" branch -f -q -- "$branch" "refs/remotes/origin/$branch" >&2
  fi
}

# A branch already checked out somewhere - the main checkout included - is
# opened where it is. Otherwise, with no base, it is picked up where it already
# is - locally, then on origin - so one that exists only on the remote is
# tracked instead of silently forked from HEAD, which herdr's own `worktree
# create` does. When origin cannot be reached, what the last fetch knew of it
# still counts. A base always means a new branch, resolved like a fresh one
# against the checkout the caller stands in. With $4 set, the branch has to come
# from origin and is brought up to it, as a pull request's head is.
_hw_add() {
  local main=$1 branch=$2 base=$3 wt_path start
  local -i remote=${4:-0}
  if [[ -n $base ]]; then
    start=$(git rev-parse -q --verify "$base^{commit}") || {
      print -u2 "hw: no such commit: $base"
      return 1
    }
  else
    start=$(git rev-parse HEAD) || return 1
  fi
  if ((remote)); then
    _hw_fetch "$main" "$branch" || {
      print -u2 "hw: could not fetch $branch from origin"
      return 1
    }
  fi

  if _hw_checked_out "$main" "$branch"; then
    [[ -z $base ]] || {
      print -u2 "hw: $branch is already checked out at $REPLY, so <base> cannot apply"
      return 1
    }
    ((remote)) && _hw_forward "$main" "$branch" "$REPLY"
    print -r -- "$REPLY"
    return 0
  fi

  wt_path=$(_hw_path "$main" "$branch")
  if [[ -d $wt_path ]]; then
    # Not checked out anywhere, so whatever sits here is another branch.
    _hw_reuse "$wt_path" "$branch"
    return 1
  elif [[ -n $base ]]; then
    git -C "$main" worktree add -b "$branch" "$wt_path" "$start" >&2 || return 1
  elif git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    ((remote)) && _hw_forward "$main" "$branch"
    git -C "$main" worktree add "$wt_path" "$branch" >&2 || return 1
  else
    if ((!remote)) && ! _hw_fetch "$main" "$branch"; then
      print -u2 "hw: could not fetch $branch from origin; using what is known of it"
    fi
    if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$main" worktree add --track -b "$branch" "$wt_path" "origin/$branch" >&2 || return 1
    else
      git -C "$main" worktree add -b "$branch" "$wt_path" "$start" >&2 || return 1
    fi
  fi
  print -r -- "$wt_path"
}

# ── rm ───────────────────────────────────────────────

# A target into REPLY: a path; else a branch of the repository here that has a
# worktree under the root or exists at all; else an open workspace's id. A
# branch comes before an id, which is herdr's to number (w1, w2, ...).
_hw_resolve() {
  local arg=$1 main=
  local -i i
  REPLY=
  if [[ $arg == */* && -d $arg ]]; then
    REPLY=${arg:A}
    return 0
  fi
  if main=$(_hw_main 2>/dev/null); then
    REPLY=$(_hw_path "$main" "$arg")
    [[ -d $REPLY ]] && return 0
    git -C "$main" show-ref --verify --quiet "refs/heads/$arg" && return 0
  fi
  if _hw_ws_load 2>/dev/null; then
    for ((i = 1; i <= ${#_HW_WS_ID}; i++)); do
      [[ ${_HW_WS_ID[i]} == "$arg" && -n ${_HW_WS_PATH[i]} ]] || continue
      REPLY=${_HW_WS_PATH[i]:A}
      return 0
    done
  fi
  [[ -n $main ]] || {
    print -u2 "hw: not a path, a workspace, or a branch of a repository here: $arg"
    return 1
  }
}

# Only a directory of the layout under $WT_ROOT is taken, which keeps out the
# main checkout and Claude Code's .claude/worktrees (its lifecycle; an agent may
# still be running there). The one thing git removes without complaint is the
# worktree the caller stands in, so that is refused here as well.
_hw_removable() {
  local wt_path=$1 root=${"$(_hw_root)":A} resolved=${1:A}
  if ! _hw_in_layout "$resolved" "$root"; then
    print -u2 "hw: not a worktree under $root: $wt_path"
    return 1
  fi
  if [[ ${PWD:A} == "$resolved" || ${PWD:A} == "$resolved"/* ]]; then
    print -u2 "hw: cannot remove the worktree you are standing in: $wt_path"
    return 1
  fi
  [[ -d $wt_path ]] || {
    print -u2 "hw: no such worktree: $wt_path"
    return 1
  }
}

# A branch is merged when origin's default branch contains it, or - what a
# squash merge leaves - when merging it there changes nothing. Its upstream
# does not count: a pushed branch whose pull request is still open is not merged.
_hw_merged() {
  local main=$1 branch=$2 tree
  git -C "$main" merge-base --is-ancestor "refs/heads/$branch" refs/remotes/origin/HEAD 2>/dev/null &&
    return 0
  tree=$(git -C "$main" merge-tree --write-tree refs/remotes/origin/HEAD "refs/heads/$branch" 2>/dev/null) ||
    return 1
  [[ $tree == "$(git -C "$main" rev-parse 'refs/remotes/origin/HEAD^{tree}' 2>/dev/null)" ]]
}

# The worktree goes first and its branch only after; the default branch stays.
_hw_drop_branch() {
  local main=$1 branch=$2 default
  [[ -n $branch ]] || return 0
  default=$(git -C "$main" symbolic-ref --short -q refs/remotes/origin/HEAD) || {
    print -u2 "hw: kept the branch $branch; origin/HEAD is not set (git remote set-head origin --auto)"
    return 0
  }
  [[ $branch != "${default#origin/}" ]] || return 0
  if _hw_merged "$main" "$branch"; then
    git -C "$main" branch -D -q -- "$branch" >&2
    return
  fi
  print -u2 "hw: kept the branch $branch, which is not merged into $default"
}

# What removing the worktree at $1 means for the open workspaces, written into
# the caller's locals (zsh scopes them dynamically): `carrier`, the workspace
# whose checkout it is, which herdr's `worktree remove` closes; `close`, the
# workspaces with no checkout of their own whose panes are all inside it, closed
# with it (not the focused one); `stranded`, the panes of any other workspace
# inside it, only named; `check`, every pane that would lose its directory.
_hw_rm_plan() {
  local wt_path=$1 ws pane
  local -i outside i
  local -a p here
  for ((i = 1; i <= ${#_HW_WS_ID}; i++)); do
    ws=${_HW_WS_ID[i]}
    _hw_panes "$ws" || return 1
    if [[ -n ${_HW_WS_PATH[i]} && ${_HW_WS_PATH[i]:A} == "$wt_path" ]]; then
      carrier=$ws
      for pane in ${(f)REPLY}; do check+=("${pane%%$'\t'*}"); done
      continue
    fi
    here=() outside=0
    for pane in ${(f)REPLY}; do
      p=("${(@ps:\t:)pane}")
      if [[ -n ${p[2]-} && (${p[2]:A} == "$wt_path" || ${p[2]:A} == "$wt_path"/*) ]]; then
        here+=("${p[1]}")
      else
        ((outside += 1))
      fi
    done
    ((${#here} > 0)) || continue
    check+=("${here[@]}")
    if [[ -z ${_HW_WS_PATH[i]} ]] && ((outside == 0)) && ! _hw_is_focused "$i"; then
      close+=("$ws")
    else
      stranded+=("${here[@]}")
    fi
  done
}

_hw_rm_idle() {
  local wt_path=$1 pane
  shift
  for pane in "$@"; do
    _hw_busy "$pane" || return 1
    [[ -z $REPLY ]] && continue
    print -u2 -r -- "hw: $pane is running $REPLY; -f removes $wt_path anyway"
    return 1
  done
}

# One worktree. herdr's `worktree remove` closes only the workspace that
# carries the checkout and removes regardless of what runs in it, so the rest is
# ours (_hw_rm_plan). Outside herdr there are no panes to check, and git alone
# removes it.
_hw_rm_one() {
  local wt_path=$1 main branch ws carrier= pane
  local -i force=$2 rc=0
  local -a close check stranded flags
  main=$(_hw_main "$wt_path") || return 1
  branch=$(git -C "$wt_path" symbolic-ref --short -q HEAD)

  if _hw_ws_load; then
    _hw_rm_plan "$wt_path" || return 1
  else
    [[ ${HERDR_ENV:-} != 1 ]] || return 1
    print -u2 'hw: not inside herdr; removing with git alone'
  fi
  ((force)) || _hw_rm_idle "$wt_path" "${check[@]}" || return 1

  ((force)) && flags=(--force)
  if [[ -n $carrier ]]; then
    _hw_herdr worktree remove --workspace "$carrier" "${flags[@]}" || return 1
  else
    git -C "$main" worktree remove "${flags[@]}" -- "$wt_path" >&2 || return
  fi
  rmdir -- "${wt_path:h}" 2>/dev/null

  for ws in "${close[@]}"; do
    _hw_herdr workspace close "$ws" || rc=1
  done
  for pane in "${stranded[@]}"; do
    print -u2 "hw: $pane is left in the removed $wt_path"
  done
  _hw_drop_branch "$main" "$branch"
  return $rc
}

# ── commands ─────────────────────────────────────────

_hw_cmd_repo() {
  local spec=${1:-} dir
  [[ -n $spec ]] || {
    print -u2 'usage: hw repo <spec|path>'
    return 1
  }
  # Checked before a clone is made that could not be opened.
  _hw_require herdr jq || return 1
  if [[ -e $spec/.git ]]; then
    dir=$spec
  else
    _hw_require repo || return 1
    dir=$(repo get "$spec") || return
  fi
  _hw_open "$dir"
}

_hw_cmd_branch() {
  local branch=${1:-} base=${2:-} main wt_path
  [[ -n $branch ]] || {
    print -u2 'usage: hw branch <name> [<base>]'
    return 1
  }
  # Checked before a worktree is made that could not be opened.
  _hw_require herdr jq || return 1
  main=$(_hw_main) || return 1
  wt_path=$(_hw_add "$main" "$branch" "$base") || return 1
  _hw_open "$wt_path"
}

# On GitHub, `gh pr checkout` is the only thing that gets a fork's head right,
# so gh adds the worktree and names its branch; a fork qualifies the local
# branch by owner when its head is the default branch. On Azure DevOps the head
# is fetched from origin, so a pull request from a fork is not reached.
_hw_cmd_pr() {
  local number=${1:-} host main branch wt_path
  number=${number#\#}
  [[ -n $number ]] || {
    print -u2 'usage: hw pr <number>'
    return 1
  }
  _hw_require herdr jq || return 1
  main=$(_hw_main) || return 1
  host=$(_hw_host) || return 1
  case $host in
    github)
      _hw_require gh || return 1
      branch=$(gh pr view "$number" --json headRefName --jq '.headRefName') || return
      [[ -n $branch ]] || {
        print -u2 "hw: could not resolve the head branch of #$number"
        return 1
      }
      wt_path=$(_hw_path "$main" "$branch")
      if _hw_checked_out "$main" "$branch"; then
        wt_path=$REPLY
      elif [[ -d $wt_path ]]; then
        _hw_reuse "$wt_path" "$branch" 1 || return 1
      else
        gh pr checkout "$number" --worktree "$wt_path" >&2 || {
          [[ ! -d $wt_path ]] || git -C "$main" worktree remove --force -- "$wt_path" >&2
          rmdir -- "${wt_path:h}" 2>/dev/null
          return 1
        }
      fi
      ;;
    azure)
      _hw_require az || return 1
      branch=$(az repos pr show --id "$number" --query sourceRefName --output tsv) || return
      branch=${branch#refs/heads/}
      [[ -n $branch ]] || {
        print -u2 "hw: could not resolve the source branch of !$number"
        return 1
      }
      wt_path=$(_hw_add "$main" "$branch" '' 1) || return 1
      ;;
  esac
  _hw_open "$wt_path"
}

# Every target is attempted, and the status is the last refusal's.
_hw_cmd_rm() {
  local arg
  local -i force=0 rc=0 st
  local -a targets
  for arg in "$@"; do
    case $arg in
      -f | --force)
        force=1
        ;;
      -h | --help)
        print -r -- 'usage: hw rm [-f] <path|branch|id>...'
        return 0
        ;;
      -*)
        print -u2 "hw rm: unknown option: $arg"
        return 1
        ;;
      *)
        targets+=("$arg")
        ;;
    esac
  done
  ((${#targets} > 0)) || {
    print -u2 'usage: hw rm [-f] <path|branch|id>...'
    return 1
  }
  for arg in "${targets[@]}"; do
    st=0
    _hw_resolve "$arg" || {
      rc=1
      continue
    }
    _hw_removable "$REPLY" || {
      rc=1
      continue
    }
    _hw_rm_one "${REPLY:A}" "$force" || st=$?
    ((st == 0)) || rc=$st
  done
  return $rc
}

_hw_cmd_close() {
  local ws
  local -i rc=0
  (($# > 0)) || {
    print -u2 'usage: hw close <id>...'
    return 1
  }
  _hw_require herdr jq || return 1
  for ws in "$@"; do
    _hw_herdr workspace close "$ws" || rc=1
  done
  return $rc
}

# `<display>\t<branch>`: the branches checked out in a worktree, then the other
# local ones, then those only origin has, each most recent first. lstrip rather
# than short, which turns into heads/<name> when a tag shares the name.
_hw_cmd_branches() {
  local main line b
  local -A held seen
  main=$(_hw_main) || return 1
  for line in ${(f)"$(git -C "$main" worktree list --porcelain)"}; do
    [[ $line == 'branch refs/heads/'* ]] && held[${line#branch refs/heads/}]=1
  done
  {
    for b in ${(f)"$(git -C "$main" for-each-ref --sort=-committerdate --format='%(refname:lstrip=2)' refs/heads)"}; do
      seen[$b]=1
      if ((${+held[$b]})); then
        printf '0\t%-8s %s\t%s\n' worktree "$b" "$b"
      else
        printf '1\t%-8s %s\t%s\n' local "$b" "$b"
      fi
    done
    for b in ${(f)"$(git -C "$main" for-each-ref --sort=-committerdate --format='%(refname:lstrip=3)' refs/remotes/origin)"}; do
      [[ $b == HEAD || -n ${seen[$b]-} ]] && continue
      printf '2\t%-8s %s\t%s\n' origin "$b" "$b"
    done
  } | sort -s -t $'\t' -k1,1 | cut -f2-
}

# `<display>\t<number>` per open pull request.
_hw_cmd_prs() {
  local host row
  local -a f
  _hw_main >/dev/null || return 1
  host=$(_hw_host) || return 1
  case $host in
    github)
      _hw_require gh || return 1
      gh pr list --limit 100 --json number,title,author \
        --jq '.[] | "#\(.number)  \(.title)  (\(.author.login))\t\(.number)"'
      ;;
    azure)
      _hw_require az || return 1
      row=$(az repos pr list --status active --top 100 \
        --query '[].[pullRequestId, title, createdBy.displayName]' --output tsv) || return
      for row in ${(f)row}; do
        f=("${(@ps:\t:)row}")
        printf '!%s  %s  (%s)\t%s\n' "${f[1]}" "${f[2]-}" "${f[3]-}" "${f[1]}"
      done
      ;;
  esac
}

# `<display>\t<subcommand>\t<argument>\t<directory>` per open workspace other
# than the focused one, whose shells the picker was opened from, and per
# worktree under the root with no workspace. A worktree is removed by its path,
# once however many workspaces stand on it; any other workspace is only closed,
# so a clone is never deleted from here.
_hw_cmd_spaces() {
  local root=${"$(_hw_root)":A} dir shown
  local -i i
  local -A listed
  _hw_ws_load || return 1
  # The focused worktree is left out whichever workspace stands on it.
  for ((i = 1; i <= ${#_HW_WS_ID}; i++)); do
    _hw_is_focused "$i" || continue
    [[ -z ${_HW_WS_PATH[i]} ]] || listed[${_HW_WS_PATH[i]:A}]=1
  done
  for ((i = 1; i <= ${#_HW_WS_ID}; i++)); do
    _hw_is_focused "$i" && continue
    dir=${_HW_WS_PATH[i]}
    [[ -z $dir ]] || dir=${dir:A}
    if _hw_in_layout "$dir" "$root"; then
      [[ -z ${listed[$dir]-} ]] || continue
      listed[$dir]=1
      _hw_label "$dir" "$root"
      printf '[%s] %s\t%s\t%s\t%s\n' "${_HW_WS_NUM[i]}" "$REPLY" rm "$dir" "$dir"
    else
      shown=${${dir/#$HOME/'~'}:-${_HW_WS_LABEL[i]}}
      printf '[%s] %s\t%s\t%s\t%s\n' "${_HW_WS_NUM[i]}" "$shown" close "${_HW_WS_ID[i]}" "$dir"
    fi
  done
  # Then the worktrees no workspace stands on, which nothing else lists.
  for dir in "$root"/*/*/*(N/); do
    [[ -z ${listed[$dir]-} ]] || continue
    _hw_label "$dir" "$root"
    printf '[-] %s\t%s\t%s\t%s\n' "$REPLY" rm "$dir" "$dir"
  done
}

# `<owner>/<repo> <branch>\t<path>` per worktree under the root, read off the
# layout rather than herdr, so it works outside herdr too.
_hw_cmd_list() {
  local root=${"$(_hw_root)":A} dir
  for dir in "$root"/*/*/*(N/); do
    _hw_label "$dir" "$root"
    printf '%s\t%s\n' "$REPLY" "$dir"
  done
}

# The focused workspace's checkout; the pane's cwd only stands in for a
# workspace off a checkout, as it moves with every `cd` in that pane.
_hw_cmd_focused() {
  local -i i
  _hw_ws_load || return 1
  for ((i = 1; i <= ${#_HW_WS_ID}; i++)); do
    _hw_is_focused "$i" || continue
    if [[ -n ${_HW_WS_PATH[i]} ]]; then
      print -r -- "${_HW_WS_PATH[i]}"
      return 0
    fi
    break
  done
  [[ -n ${HERDR_ACTIVE_PANE_CWD:-} ]] || {
    print -u2 'hw: the focused workspace has no checkout'
    return 1
  }
  print -r -- "$HERDR_ACTIVE_PANE_CWD"
}

# ── dispatch ─────────────────────────────────────────

cmd=${1:-}
(($# == 0)) || shift
case $cmd in
  root)
    _hw_root
    ;;
  repo)
    _hw_cmd_repo "$@"
    ;;
  branch)
    _hw_cmd_branch "$@"
    ;;
  pr)
    _hw_cmd_pr "$@"
    ;;
  rm)
    _hw_cmd_rm "$@"
    ;;
  close)
    _hw_cmd_close "$@"
    ;;
  branches)
    _hw_cmd_branches "$@"
    ;;
  prs)
    _hw_cmd_prs "$@"
    ;;
  spaces)
    _hw_cmd_spaces "$@"
    ;;
  list)
    _hw_cmd_list "$@"
    ;;
  focused)
    _hw_cmd_focused "$@"
    ;;
  -h | --help | help)
    _hw_usage
    ;;
  '')
    _hw_usage >&2
    exit 1
    ;;
  *)
    print -u2 "hw: unknown subcommand: $cmd"
    _hw_usage >&2
    exit 1
    ;;
esac

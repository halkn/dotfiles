#!/bin/zsh
# git-wt - git worktree のライフサイクル（作成 / PR レビュー用の払い出し / 後片付け）を fzf で回す。
#
# `git wt ...` として git のサブコマンドから起動できる。副作用のあと対象 worktree の絶対 path を
# 返し、呼び出し側（zsh の wt 関数、herdr-picker.sh）が cd するか
# `herdr worktree open --path` に渡すかを決める。進捗とエラーは全て stderr に出す。
set -euo pipefail

# worktree の置き場。herdr の worktrees.directory と同じ場所を指す必要がある
# （.config/herdr/config.toml 側にも同じ literal がある）
wt_root=${WT_ROOT:-$HOME/worktrees}

# 新しい worktree に本体から複製する未追跡ファイル。git 管理外なので worktree には
# 引き継がれず、無いと Claude Code や mise がその場で動き出せない
wt_copy=${WT_COPY:-".env .env.local mise.local.toml .claude/settings.local.json"}

note() {
  print -r -- "git-wt: $1" >&2
}

die() {
  note "$1"
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not installed or not in PATH"
}

in_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die 'not inside a git repository'
}

usage() {
  cat >&2 <<'EOF'
usage: git wt [cd]                既存 worktree を選んで移動する
       git wt new <branch> [-c]   origin/HEAD から新しい worktree を切る
       git wt pr [<number>] [-c]  PR を選んでレビュー用 worktree を作る
       git wt rm [-f]             worktree を選んで削除する（複数選択可）
       git wt rm --path <dir>     指定した worktree を削除する（fzf を使わない）
       git wt clean               merge / close 済みの worktree をまとめて削除する

  -c, --claude   worktree に移動して Claude Code を起動する

環境変数: WT_ROOT (既定 ~/worktrees), WT_COPY
EOF
  exit 1
}

# 結果の path。WT_PATH_FILE があればそこへ、無ければ stdout へ書く。前者は wt 関数用で、
# stdout を claude に明け渡したまま path を返せる。後者は `$(...)` で捕捉する呼び出し元用
emit_path() {
  if [[ -n ${WT_PATH_FILE:-} ]]; then
    print -r -- "$1" >|"$WT_PATH_FILE"
  else
    print -r -- "$1"
  fi
}

# メインの作業ツリー。worktree の中から呼ばれても常に本体を指す
# （--porcelain の最初のレコードが必ず main worktree）
main_worktree() {
  git worktree list --porcelain \
    | awk '/^worktree /{print substr($0, 10); exit}'
}

# `worktree <path>` / `branch refs/heads/<name>` のレコード列を "<branch>\t<path>" に畳む。
# --porcelain を使うのは空白を含む path でも壊れないようにするため
list_worktrees() {
  git worktree list --porcelain | awk '
    /^worktree /  { path = substr($0, 10) }
    /^branch /    { br = substr($0, 8); sub(/^refs\/heads\//, "", br) }
    /^detached$/  { br = "(detached)" }
    /^$/          { if (path != "") printf "%s\t%s\n", br, path; path = ""; br = "" }
    END           { if (path != "") printf "%s\t%s\n", br, path }
  '
}

# ディレクトリ名に使えるようにする。herdr の <repo>/<branch-slug> レイアウトに合わせる
slugify() {
  print -r -- "${1//\//-}"
}

# 分岐元。origin/HEAD が未設定の clone があるので、取れなければ remote から引き直す
default_base() {
  local head
  head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && {
    print -r -- "$head"
    return 0
  }
  git remote set-head origin --auto >/dev/null 2>&1 || return 1
  head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || return 1
  print -r -- "$head"
}

worktree_dir() {
  local main
  main=$(main_worktree)
  print -r -- "$wt_root/${main:t}/$(slugify "$1")"
}

copy_local_files() {
  local src=$1 dst=$2 rel
  for rel in ${(z)wt_copy}; do
    if [[ -e $src/$rel ]]; then
      mkdir -p -- "$dst/${rel:h}"
      cp -R -- "$src/$rel" "$dst/$rel"
      note "copied: $rel"
    fi
  done
}

# -c は「worktree に移動して claude を起動」。stdout を `$(...)` で捕捉している呼び出し元
# （herdr-picker.sh）では端末を渡せないので何もしない
maybe_launch() {
  local launch=$1 dir=$2
  shift 2
  ((launch)) || return 0
  if [[ -z ${WT_PATH_FILE:-} && ! -t 1 ]]; then
    note 'stdout is captured; skipping claude launch'
    return 0
  fi
  need claude
  cd -- "$dir"
  exec claude "$@"
}

pick_worktree() {
  local main
  main=$(main_worktree)
  # 本体は worktree として削除できないので選択肢から外す
  list_worktrees \
    | awk -F'\t' -v main="$main" '$2 != main' \
    | fzf --delimiter '\t' --with-nth 1,2 "$@" \
      --style=full --border-label=' worktrees ' --prompt='worktree> ' \
      --preview 'git -C {2} status --short --branch; echo; git -C {2} log --oneline --decorate --color=always -20' \
    | cut -f2
}

cmd_cd() {
  in_repo
  need fzf
  local dir
  dir=$(pick_worktree) || return 0
  [[ -n $dir ]] || return 0
  emit_path "$dir"
}

cmd_new() {
  in_repo
  local branch='' launch=0
  while (($#)); do
    case $1 in
      -c | --claude)
        launch=1
        ;;
      -h | --help)
        usage
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        [[ -z $branch ]] || die 'branch name given twice'
        branch=$1
        ;;
    esac
    shift
  done
  [[ -n $branch ]] || usage

  local dir base main
  dir=$(worktree_dir "$branch")
  [[ ! -e $dir ]] || die "already exists: $dir"

  note 'fetching origin...'
  git fetch --quiet origin
  base=$(default_base) ||
    die 'cannot resolve origin/HEAD; run: git remote set-head origin --auto'

  mkdir -p -- "${dir:h}"
  if git show-ref --quiet --verify "refs/heads/$branch"; then
    # 既存のローカルブランチは作り直さずそのまま check out する
    note "checking out existing branch: $branch"
    git worktree add "$dir" "$branch" >&2
  else
    git worktree add -b "$branch" "$dir" "$base" >&2
  fi

  main=$(main_worktree)
  copy_local_files "$main" "$dir"
  emit_path "$dir"
  maybe_launch "$launch" "$dir"
}

pick_pr() {
  gh pr list --limit 100 \
    --json number,title,author,headRefName,isDraft \
    --jq '.[] | "#\(.number)\t\(if .isDraft then "draft" else "open " end)\t\(.author.login)\t\(.title)\t\(.number)"' \
    | fzf --delimiter '\t' --with-nth 1,2,3,4 \
      --style=full --border-label=' pull requests ' --prompt='pr> ' \
      --preview 'gh pr view {5} --comments; echo; gh pr diff {5} --color always' \
    | cut -f5
}

cmd_pr() {
  in_repo
  need gh
  local number='' launch=0
  while (($#)); do
    case $1 in
      -c | --claude)
        launch=1
        ;;
      -h | --help)
        usage
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        [[ $1 == <-> ]] || die "not a pull request number: $1"
        number=$1
        ;;
    esac
    shift
  done

  if [[ -z $number ]]; then
    need fzf
    number=$(pick_pr) || return 0
    [[ -n $number ]] || return 0
  fi

  local head_ref branch dir url main
  head_ref=$(gh pr view "$number" --json headRefName --jq '.headRefName')
  url=$(gh pr view "$number" --json url --jq '.url')
  branch=pr-$number-$(slugify "$head_ref")
  dir=$(worktree_dir "$branch")

  if [[ -e $dir ]]; then
    note "reusing existing worktree: $dir"
  else
    # pull/<n>/head は fork からの PR も同じ手順で取れる（gh pr checkout と違い remote を増やさない）
    note "fetching pull/$number/head..."
    git fetch --quiet --force origin "pull/$number/head:$branch"
    mkdir -p -- "${dir:h}"
    git worktree add "$dir" "$branch" >&2
    main=$(main_worktree)
    copy_local_files "$main" "$dir"
  fi

  emit_path "$dir"
  maybe_launch "$launch" "$dir" "/review $url"
}

# push 済みで作業中の変更も無い worktree だけを黙って消す。それ以外は理由を出して飛ばす。
# strict=0 は clean 用: merge / close 済みであることを呼び出し側が確認済みで、かつ
# PR レビュー用ブランチは fetch で作るので常に upstream を持たない
removable() {
  local dir=$1 strict=${2:-1} br upstream
  if [[ -n $(git -C "$dir" status --porcelain) ]]; then
    note "skip (uncommitted changes): $dir"
    return 1
  fi
  ((strict)) || return 0
  br=$(git -C "$dir" branch --show-current)
  [[ -n $br ]] || return 0
  if ! upstream=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
    note "skip (branch never pushed): $dir"
    return 1
  fi
  if [[ -n $(git -C "$dir" log --oneline "$upstream..HEAD") ]]; then
    note "skip (unpushed commits): $dir"
    return 1
  fi
  return 0
}

# worktree を消し、ブランチも片付ける。既定は安全側の --delete で、merge 済みでなければ
# ブランチを残す。drop_branch=1 は clean 用（squash merge された PR のブランチは
# --delete では消せないが、PR が MERGED/CLOSED である以上失うものは無い）
drop_worktree() {
  local dir=$1 drop_branch=${2:-0} br
  br=$(git -C "$dir" branch --show-current 2>/dev/null) || br=''
  # 消してよいかの判断は removable()（と rm -f）で済ませているので、ここでは
  # 未追跡 / 無視されるだけのファイル（コピーした mise.local.toml 等）に妨げられないようにする
  git worktree remove --force "$dir" >&2 || return 1
  note "removed: $dir"
  [[ -n $br ]] || return 0
  if ((drop_branch)); then
    if git branch --delete --force "$br" >/dev/null 2>&1; then
      note "deleted branch: $br"
    fi
  elif git branch --delete "$br" >/dev/null 2>&1; then
    note "deleted branch: $br"
  else
    note "kept branch (not merged): $br"
  fi
}

cmd_rm() {
  # zsh の $path は $PATH に結び付いた特殊変数なので、この名前は使えない
  local force='' wt_path=''
  while (($#)); do
    case $1 in
      -f | --force)
        force=1
        ;;
      --path)
        shift
        wt_path=${1:-}
        [[ -n $wt_path ]] || die '--path requires a value'
        ;;
      -h | --help)
        usage
        ;;
      *)
        die "unknown option: $1"
        ;;
    esac
    shift
  done

  # --path は herdr popup など repo の外から呼ばれるので、対象 worktree 側から本体を
  # 解決して移動する（削除対象の中に居ると git worktree remove が失敗するため）
  if [[ -n $wt_path ]]; then
    [[ -d $wt_path ]] || die "no such worktree: $wt_path"
    cd -- "$wt_path"
    in_repo
    cd -- "$(main_worktree)"
    if [[ -z $force ]]; then
      removable "$wt_path" || return 1
    fi
    drop_worktree "$wt_path"
    git worktree prune
    return 0
  fi

  in_repo
  need fzf

  local selected dir
  selected=$(pick_worktree --multi) || return 0
  [[ -n $selected ]] || return 0

  while IFS= read -r dir; do
    [[ -n $dir ]] || continue
    if [[ -z $force ]]; then
      removable "$dir" || continue
    fi
    drop_worktree "$dir" || true
  done <<<"$selected"
  git worktree prune
}

cmd_clean() {
  in_repo
  local main base
  main=$(main_worktree)
  note 'fetching origin...'
  git fetch --quiet --prune origin
  base=$(default_base) ||
    die 'cannot resolve origin/HEAD; run: git remote set-head origin --auto'

  local -a stale_dirs stale_desc
  local br dir state reason
  while IFS=$'\t' read -r br dir; do
    [[ $dir != "$main" ]] || continue
    reason=''
    case $br in
      pr-<->-*)
        # PR 由来の worktree は squash merge で ancestor にならないため PR の状態で判断する
        need gh
        if state=$(gh pr view "${${br#pr-}%%-*}" --json state --jq '.state' 2>/dev/null); then
          if [[ $state == MERGED || $state == CLOSED ]]; then
            reason=${state:l}
          fi
        fi
        ;;
      *)
        if git merge-base --is-ancestor "$br" "$base" 2>/dev/null; then
          reason=merged
        fi
        ;;
    esac
    if [[ -n $reason ]]; then
      stale_dirs+=("$dir")
      stale_desc+=("$dir  [$br: $reason]")
    fi
  done < <(list_worktrees)

  if ((${#stale_dirs} == 0)); then
    note 'nothing to clean'
    return 0
  fi

  print -rl -- "${stale_desc[@]}" >&2
  print -n 'remove these worktrees? [y/N] ' >&2
  local reply
  read -r reply </dev/tty
  [[ $reply == [yY]* ]] || {
    note 'aborted'
    return 0
  }

  for dir in "${stale_dirs[@]}"; do
    if removable "$dir" 0; then
      drop_worktree "$dir" 1 || true
    fi
  done
  git worktree prune
}

need git

sub=${1:-cd}
if (($#)); then
  shift
fi

case $sub in
  cd)
    cmd_cd "$@"
    ;;
  new)
    cmd_new "$@"
    ;;
  pr)
    cmd_pr "$@"
    ;;
  rm)
    cmd_rm "$@"
    ;;
  clean)
    cmd_clean "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    die "unknown subcommand: $sub (try: git wt --help)"
    ;;
esac

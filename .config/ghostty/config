# ── macOS ────────────────────────────────────────────
macos-option-as-alt = true
macos-titlebar-style = hidden

# ── Font ─────────────────────────────────────────────
font-family = "UDEV Gothic NF"
font-size = 14

# ── Theme ────────────────────────────────────────────
theme = "Kanagawa Wave"

# ── Window ───────────────────────────────────────────
window-padding-balance = true

# ── Keybind ──────────────────────────────────────────
# The ¥ key on a JIS layout sends a yen sign; send a backslash instead.
keybind = ¥=text:\\

# ── Behavior ─────────────────────────────────────────
mouse-hide-while-typing = true
quit-after-last-window-closed = true
# Updates come from the Homebrew cask, so Sparkle must not also apply them.
auto-update = off

[status]
  showUntrackedFiles = all
[diff]
  algorithm = "histogram"
  mnemonicPrefix = true
[merge]
  conflictstyle = zdiff3
[column]
  ui = auto
[branch]
  sort = -committerdate
# Lexicographic refname order puts v1.10 before v1.9.
[tag]
  sort = version:refname
[commit]
  verbose = true
# Aborts on malformed objects and on the .gitmodules / .GIT injections fsck knows about.
[transfer]
  fsckObjects = true
  credentialsInUrl = die
[fetch]
  prune = true
  pruneTags = true
  all = true
[pull]
  ff = only
[push]
  autoSetupRemote = true
[include]
  path = config.local
[alias]
  st = status
  br = branch
  ba = branch -av
  sw = switch
  sm = "!git switch main && git pull && git pm"
  diff-narrow = -c core.pager=\"hunk pager --mode stack\" diff
  prdiff = "!f() { git diff --no-color \"$(git merge-base \"${1:-origin/main}\" HEAD)\" | hunk patch -; }; f"
  pm = "!f() { base=\"${1:-origin/main}\"; current=$(git branch --show-current); git for-each-ref --format='%(refname:short)' --merged=\"$base\" refs/heads | while IFS= read -r branch; do [ -n \"$branch\" ] || continue; [ \"$branch\" = \"$current\" ] && continue; [ \"$branch\" = \"main\" ] && continue; git branch -d \"$branch\"; done; }; f"
[core]
  pager = hunk pager
  hooksPath = ~/.config/git/hooks
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
  # Deleting a todo line silently drops the commit under the default "ignore".
  missingCommitsCheck = error
[init]
  defaultBranch = main
[safe]
  bareRepository = explicit
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

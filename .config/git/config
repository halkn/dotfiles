[status]
  showUntrackedFiles = all
[diff]
  algorithm = "histogram"
  mnemonicPrefix = true
[merge]
  conflictstyle = zdiff3
# Tags only: columns bury the `*` marker in branch listings and split untracked paths.
[column]
  tag = auto
# git pages branch listings by default, taking over the screen for a few lines.
[pager]
  branch = false
[branch]
  sort = -committerdate
# Refname order puts v1.10 before v1.9.
[tag]
  sort = version:refname
[commit]
  verbose = true
[transfer]
  fsckObjects = true
  credentialsInUrl = die
[fetch]
  prune = true
  pruneTags = true
  all = true
[pull]
  ff = only
[push]
  autoSetupRemote = true
[include]
  path = config.local
[alias]
  st = status
  br = branch
  ba = branch -av
  sw = switch
  # The default branch comes from origin/HEAD, as in bin/wt. Without it they stop rather than
  # assume `main`, which is the guess these used to hard-code.
  sm = "!f() { d=$(git symbolic-ref --short -q refs/remotes/origin/HEAD) || { echo 'origin/HEAD が未設定です。git remote set-head origin --auto で設定してください' >&2; return 1; }; git switch \"${d#origin/}\" && git pull && git pm; }; f"
  diff-split = -c delta.side-by-side=true diff
  prdiff = "!f() { base=\"${1:-}\"; if [ -z \"$base\" ]; then base=$(git symbolic-ref --short -q refs/remotes/origin/HEAD) || { echo 'origin/HEAD が未設定です。git remote set-head origin --auto で設定してください' >&2; return 1; }; fi; git diff \"$(git merge-base \"$base\" HEAD)\"; }; f"
  pm = "!f() { d=$(git symbolic-ref --short -q refs/remotes/origin/HEAD) || { echo 'origin/HEAD が未設定です。git remote set-head origin --auto で設定してください' >&2; return 1; }; base=\"${1:-$d}\"; current=$(git branch --show-current); git for-each-ref --format='%(refname:short)' --merged=\"$base\" refs/heads | while IFS= read -r branch; do [ -n \"$branch\" ] || continue; [ \"$branch\" = \"$current\" ] && continue; [ \"$branch\" = \"${d#origin/}\" ] && continue; git branch -d \"$branch\"; done; }; f"
[core]
  pager = delta
  hooksPath = ~/.config/git/hooks
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
  # The default "ignore" drops commits deleted from the todo without a word.
  missingCommitsCheck = error
[init]
  defaultBranch = main
[safe]
  bareRepository = explicit
[credential "https://github.com"]
	helper = ""
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = ""
	helper = !gh auth git-credential

#!/usr/bin/env bash
#MISE description="Claude Code の hook と git の pre-push のテスト"
set -uo pipefail

hooks="$PWD/claude/hooks"
cwd=/repo
rc=0

# run <hook> <command>: prints the hook's stdout, returns its exit code.
run() {
  jq -n --arg c "$2" --arg d "$cwd" '{cwd: $d, tool_input: {command: $c}}' | bash "$hooks/$1" 2>/dev/null
}

fail() {
  printf 'FAIL %s: want %s, got %s: %.80s\n' "$1" "$2" "$3" "$4"
  rc=1
}

# expect <exit code> <command>
expect() {
  local got
  run block-piped-excluded.sh "$2" >/dev/null
  got=$?
  [ "$got" -eq "$1" ] || fail block-piped-excluded.sh "$1" "$got" "$2"
}

nl=$'\n'

# block-piped-excluded.sh

expect 2 'git ls-remote origin HEAD | head -1'
expect 2 'true && git push'
expect 2 'git push && true'
expect 2 'git push; true'
expect 2 'cd /x; git push'
expect 2 "git push${nl}true"
expect 2 'gh pr view $(git branch --show-current)'
expect 2 'gh api x -H "a: $(echo a)"'
expect 2 'gh api x -H "a: `echo a`"'
expect 2 'git push |& tail'
expect 2 'git push || true'
expect 2 'diff <(gh api x) y'
expect 2 'cd /x && git push | tail'
expect 2 'git  push | tail'
expect 2 'cd ~/x && git push'
expect 2 'cd "/x" && git push'
expect 2 "cd '/x' && git push"
expect 2 'cd $HOME/x && git push'
expect 2 'cd "$HOME/x" && git push'
expect 2 'cd . && git push'
expect 2 'cd x && gh pr view'
expect 2 'cd /x && git push'
expect 2 'cd /x/y-z.1 && gh pr view'
expect 2 'cd /repo/sub && gh pr view'
expect 2 'git push > push.log'
expect 2 'git push >> push.log'
expect 2 'git push 2>/dev/null'
expect 2 'git push &> push.log'
expect 2 'gh api x --input - < body.json'
expect 2 "gh pr create --body-file - <<'EOF'${nl}body${nl}EOF"
expect 2 'git -C /x push'
expect 2 'git -c push.default=current push'
expect 2 'git --no-pager fetch'
expect 2 'GH_PAGER=cat gh pr view'
expect 2 "A='x y' B=1 git push"
expect 2 'env GH_PAGER=cat gh pr view'
expect 2 'env -u FOO git push'
expect 2 'nice env -u CLAUDE_CODE_CHILD_SESSION git push origin x'
expect 2 'nice -n 5 git push'
expect 2 'time gh pr view'
expect 2 'timeout 30 git fetch'
expect 2 'nohup git push'
expect 2 'stdbuf -oL gh pr view'
expect 2 'command gh pr view'
expect 2 'builtin gh pr view'
expect 2 'noglob gh pr view'
expect 2 'xargs git push'
expect 2 'cd /repo && git push'
expect 2 'cd /repo/ && gh pr view'
expect 2 'git clone https://github.com/x/y /tmp/claude/y'
expect 2 'git clone --depth 1 https://github.com/x/y ~/y'
expect 2 'git clone https://github.com/x/y ../y'
expect 2 $'gh\tpr view | cat'
# Long enough to overflow a pipe buffer after an early match.
expect 2 "git push${nl}$(printf 'echo %0100d\n' $(seq 1000))"

expect 0 'git push'
expect 0 'git push 2>&1'
expect 0 'git push >&2'
expect 0 'git clone https://github.com/x/y'
expect 0 'git clone --depth 1 https://github.com/x/y y'
expect 0 'git clone git@github.com:x/y.git sub/y'
expect 0 'nice make lint'
expect 0 'time mise run lint'
expect 0 'git pull | tail'
expect 0 'git submodule update | tail'
expect 0 'git -C /x status'
expect 0 'git log --oneline > log.txt'
expect 0 'gh api repos/x -f title=a'
expect 0 'FOO=1 git status'
expect 0 'environment-check gh-like'
expect 0 "gh pr create --body \"a | b; c${nl}d\""
expect 0 "gh pr create --body \"say \\\"a | b\\\" here\""
expect 0 "gh api repos/x --jq '.[] | .name'"
expect 0 "gh api repos/x --jq '.[] | select(.n > 1)'"
expect 0 "gh api repos/x --jq \"it's | fine\""
expect 0 "rg 'git push' README.md | head"
expect 0 'git status | head'
expect 0 'git log --oneline | head -5'
expect 0 'echo high | cat'

# .config/git/hooks/pre-push, run by `git push --dry-run` against a scratch bare remote.

# macOS mktemp ignores $TMPDIR without a template; an empty $pp would point git at this repo.
pp="$(mktemp -d "${TMPDIR:-/tmp}/test-pre-push.XXXXXX")" || exit 1
trap 'rm -rf "$pp"' EXIT
hook_dir="$PWD/.config/git/hooks"

g() {
  git -C "$pp/w" -c core.hooksPath="$hook_dir" -c user.name=t -c user.email=t@t "$@"
}

# pre_push <agent|human>[-allow] <push args>: the -allow form sets ALLOW_FORCE_PUSH=1.
pre_push() {
  local who="$1"
  shift
  (
    unset CLAUDE_CODE_CHILD_SESSION ALLOW_FORCE_PUSH
    case "$who" in
      agent*)
        export CLAUDE_CODE_CHILD_SESSION=1
        ;;
    esac
    case "$who" in
      *-allow)
        export ALLOW_FORCE_PUSH=1
        ;;
    esac
    g push --dry-run -q "$@"
  ) 2>&1 >/dev/null
}

# expect_pre_push <who> <ok|reject> <push args>: a refusal counts only with the hook's own
# message, so a crash in the hook (also a non-zero exit) does not pass as one.
expect_pre_push() {
  local who="$1" want="$2" got=ok err
  shift 2
  if ! err="$(pre_push "$who" "$@")"; then
    got="crash: $err"
    grep -q '^pre-push: ' <<<"$err" && got=reject
  fi
  [ "$got" = "$want" ] || fail pre-push "$want" "$got" "$who: git push $*"
}

git init -q --bare "$pp/r.git" || exit 1
git init -q -b main "$pp/w" || exit 1
g remote add origin "$pp/r.git"
g commit -q --allow-empty -m c1
g tag v1
g switch -q -c feat && g commit -q --allow-empty -m c2
g switch -q -c div main && g commit -q --allow-empty -m c4
g switch -q -c trunk main
(unset CLAUDE_CODE_CHILD_SESSION && g push -q origin main feat div trunk v1) >/dev/null 2>&1 || exit 1
g symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/trunk
g switch -q feat && g commit -q --allow-empty -m c3
g switch -q div && g reset -q --hard main && g commit -q --allow-empty -m c5
g tag -f v1 feat >/dev/null
g tag v2 feat
orphan="$(g commit-tree "$(g write-tree)" -m orphan)" || exit 1

expect_pre_push agent ok origin feat
expect_pre_push agent ok origin feat:refs/heads/new-branch
expect_pre_push agent ok origin v2
expect_pre_push agent reject origin +div
expect_pre_push agent reject -uf origin div
expect_pre_push agent reject origin :feat
expect_pre_push agent reject --delete origin feat
expect_pre_push agent reject --del origin feat
expect_pre_push agent reject origin feat:main
expect_pre_push agent reject origin feat:develop
expect_pre_push agent reject origin feat:release/1.0
expect_pre_push agent reject origin feat:trunk
expect_pre_push agent reject origin +v1
expect_pre_push agent-allow reject origin +div

expect_pre_push human ok origin +div
expect_pre_push human ok origin +v1
expect_pre_push human ok origin feat:main
expect_pre_push human ok origin feat:develop
expect_pre_push human reject origin "+$orphan:main"
expect_pre_push human reject origin :main
expect_pre_push human-allow ok origin "+$orphan:main"
expect_pre_push human-allow ok origin :main

# guard-gh.sh, which resolves origin and the current branch from the input `cwd`.

gh_on_main="$pp/gh-on-main"
gh_on_feature="$pp/gh-on-feature"
git init -q -b main "$gh_on_main"
git -C "$gh_on_main" remote add origin git@github.com:halkn/x.git
git init -q -b feature "$gh_on_feature"
git -C "$gh_on_feature" remote add origin https://github.com/other/x.git
gh_cwd="$gh_on_feature"

# expect_gh <block|ask|pass> <command>, run from the repository in $gh_cwd.
expect_gh() {
  local out code got
  out="$(jq -n --arg c "$2" --arg d "$gh_cwd" '{cwd: $d, tool_input: {command: $c}}' \
    | bash "$hooks/guard-gh.sh" 2>/dev/null)"
  code=$?
  if [ "$code" -eq 2 ]; then
    got=block
  elif [ "$code" -ne 0 ]; then
    got="exit $code"
  elif [ -n "$out" ]; then
    got="$(printf '%s' "$out" | jq -r '.hookSpecificOutput.permissionDecision')"
  else
    got=pass
  fi
  [ "$got" = "$1" ] || fail guard-gh.sh "$1" "$got" "(${gh_cwd##*/}) $2"
}
pr() { expect_gh "$@"; }
gw() { expect_gh "$@"; }

# guard-gh.sh: gh pr create

gh_cwd="$gh_on_main"
pr pass 'gh pr create --fill'
pr ask 'gh pr create --repo other/x --fill'
pr pass 'gh pr view'

gh_cwd="$gh_on_feature"
pr ask 'gh pr create --fill'
pr pass 'gh pr create --repo halkn/x --fill'
pr pass 'gh pr create -R https://github.com/halkn/x --fill'

gh_cwd="$pp"
pr ask 'gh pr create --fill'

# guard-gh.sh: merges and guard changes

gh_cwd="$gh_on_feature"
gw ask 'gh pr merge 1'
gw ask 'gh pr merge 1 --squash --auto'
gw ask 'time gh pr merge 1'
gw ask 'gh repo edit --default-branch dev'
gw ask 'gh repo edit --visibility public --accept-visibility-change-consequences'
gw ask 'gh api -X PUT repos/halkn/x/pulls/1/merge'
gw ask 'gh api -XPUT repos/halkn/x/pulls/1/merge'
gw ask 'gh api --method=PUT repos/{owner}/{repo}/pulls/1/merge'
gw ask "gh api 'repos/halkn/x/pulls/1/merge' --method put"
gw ask 'gh api https://api.github.com/repos/halkn/x/pulls/1/merge -X PUT'
gw ask 'gh api repos/halkn/x/merges -f base=main -f head=feature'
gw ask 'gh api repos/halkn/x/merge-upstream -f branch=main'
gw ask 'gh api -X PATCH repos/halkn/x/git/refs/heads/main -f sha=abc -F force=true'
gw ask 'gh api -X DELETE /repos/halkn/x/git/refs/heads/master'
gw ask 'gh api repos/halkn/x/git/refs -f ref=refs/heads/main -f sha=abc'
gw ask 'gh api -X PUT repos/halkn/x/branches/main/protection --input p.json'
gw ask 'gh api -X DELETE repos/halkn/x/branches/main/protection/required_pull_request_reviews'
gw ask 'gh api repos/halkn/x/branches/main/rename -f new_name=trunk'
gw ask 'gh api repos/halkn/x/rulesets --input ruleset.json'
gw ask 'gh api -X DELETE repos/halkn/x/rulesets/1'
gw ask 'gh api -X PUT orgs/halkn/rulesets/1 --input r.json'
gw ask 'gh api -X PATCH repos/halkn/x -f visibility=public'
gw block 'gh api repos/halkn/x -X DELETE'
gw ask 'gh api repos/halkn/x/transfer -f new_owner=other'
gw ask 'gh api -X PUT repos/halkn/x/contents/README.md -f message=m -f content=Yg=='
gw ask "gh api graphql -f query='${nl}mutation {${nl}  mergePullRequest(input: {pullRequestId: \"x\"}) { clientMutationId }${nl}}'"
gw ask "gh api graphql -f query='mutation { updateRepositoryRuleset(input: {}) { clientMutationId } }'"
gw ask "gh api graphql -f query='mutation { enablePullRequestAutoMerge(input: {}) { clientMutationId } }'"
gw ask 'gh api graphql -F query=@mutation.graphql'
gw ask 'gh api graphql --input body.json'

gw pass 'gh pr view 1'
gw pass 'gh pr edit 1 --body-file .scratch/pr.md'
gw pass 'gh repo view'
gw pass 'gh api repos/halkn/x/pulls/1'
gw pass 'gh api repos/halkn/x/rulesets'
gw pass 'gh api repos/halkn/x/branches/main/protection'
gw pass 'gh api repos/halkn/x'
gw pass 'gh api repos/halkn/x/contents/README.md'
gw pass 'gh api -X GET search/issues -f q=repo:halkn/x'
gw pass 'gh api -X GET repos/halkn/x/git/refs -f ref=refs/heads/main'
gw pass 'gh api repos/halkn/x/issues/1/comments -f body=hello'
gw pass "gh api repos/halkn/x/pulls/1/comments -f body='merge it to main'"
gw pass 'gh api -X PATCH repos/halkn/x/pulls/1 -f body=updated'
gw pass 'gh api -X PATCH repos/halkn/x/git/refs/heads/feature -f sha=abc'
gw pass 'gh api -X PATCH repos/halkn/x/git/refs/heads/main-fix -f sha=abc'
gw pass 'gh api -X PATCH repos/halkn/x/git/refs/heads/{branch} -f sha=abc'
gw pass "gh api graphql -f query='query { viewer { login } }'"
gw pass "gh api graphql -f query='mutation { addComment(input: {}) { clientMutationId } }'"
gw pass "rg 'gh pr merge' README.md"

gh_cwd="$gh_on_main"
gw ask 'gh api -X PATCH repos/halkn/x/git/refs/heads/{branch} -f sha=abc'
gw ask 'gh api -X PATCH repos/:owner/:repo/git/refs/heads/:branch -f sha=abc'

# Quoted values, flags in front of the subcommand, and other endpoint shapes.
gh_cwd="$gh_on_feature"
gw ask "gh api -f 'commit_title=fix(hooks): x' -X PUT repos/halkn/x/pulls/1/merge"
gw ask "gh api repos/halkn/x/pulls/1/merge --jq '.sha | .[0:7]' -X PUT"
gw ask "gh api -H 'X-A: a;b' -X PATCH repos/halkn/x -f default_branch=dev"

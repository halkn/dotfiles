gw ask 'gh api -H "a: $(echo a)" -X PUT repos/halkn/x/pulls/1/merge'
gw ask 'gh pr -R halkn/x merge 1'
gw ask 'gh -R halkn/x pr merge 1'
gw ask 'env gh pr merge 1'
gw ask "gh api /graphql -f query='mutation { mergePullRequest(input: {}) { clientMutationId } }'"
gw ask 'gh api -X PUT repositories/123/pulls/1/merge'

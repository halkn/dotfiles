gw block 'gh repo delete halkn/x --yes'
gw block 'gh repo --yes=true delete halkn/x'
gw block 'gh api -X DELETE repositories/123'
gw block 'true; gh pr merge 1; gh auth token'
gw pass 'gh auth status'
gw pass 'gh auth status --active --hostname github.com'
gw pass "gh auth status --json hosts --template '{{.}}'"

gh_cwd="$gh_on_main"
pr pass 'gh pr new --fill'
pr ask 'gh pr new --repo other/x --fill'
pr ask 'gh -R other/x pr create'
pr ask 'gh pr -R other/x create'
pr ask 'gh pr create -Rother/x'
pr ask 'GH_REPO=other/x gh pr create --fill'
pr ask "gh pr create --title 'fix(x): y' --repo other/x"

exit $rc

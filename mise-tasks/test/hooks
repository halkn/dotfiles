gw ask "gh api graphql -F x='(a)' -F query=@m.graphql"
gw ask 'gh api -X POST repos/halkn/x/git/refs -F ref=@ref.txt -f sha=abc'
gw ask 'gh api -X POST repos/halkn/x/git/refs --input ref.json'
gw ask "gh api graphql -f query='mutation { enqueuePullRequest(input: {}) { clientMutationId } }'"
gw ask 'gh repo archive halkn/x --yes'
gw ask 'gh repo rename y --yes'
gw ask 'gh repo sync halkn/x --branch main --force'
gw ask 'gh alias set m "pr merge"'
gw pass 'gh api -X POST repos/halkn/x/git/refs -f ref=refs/heads/feature -f sha=abc'
gw pass "gh pr view 1 --json title --jq '.title | ascii_downcase'"
gw pass 'gh run list --workflow cd --limit 5'

# Denied: tokens, login state and repository deletion, also behind flags.
gw block 'gh auth token'
gw block 'gh auth --hostname github.com token'
gw block 'gh auth refresh -s delete_repo'
gw block 'gh auth login'
gw block 'gh auth logout --hostname example.invalid'
gw block 'gh auth switch'
gw block 'gh auth setup-git'
gw block 'gh auth status --show-token'
gw block 'gh auth status -t'
gw block 'gh auth status -at'

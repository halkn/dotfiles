#!/usr/bin/env bash
#MISE description="Claude Code をインストール（未導入時のみ）"
#MISE hide=true
# `mise bootstrap` runs this as its last step, so it has to stay idempotent.
set -euo pipefail

# Claude Code is in the mise registry, but it self-updates in place and would drift from the
# lockfile, so it stays on its own installer.
command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash

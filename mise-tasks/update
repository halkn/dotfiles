#!/usr/bin/env bash
#MISE description="mise 本体・ツール・OS パッケージ・zsh プラグイン・herdr プラグイン・Claude Code・Rust toolchain を更新"
# No `set -e`: every step is independent, so one failure must not skip the rest.
set -uo pipefail

failed=()

step() {
  local name=$1
  shift
  "$@" || failed+=("$name")
}

optional_step() {
  local name=$1
  shift
  if command -v "$1" >/dev/null; then
    step "$name" "$@"
  else
    echo "skip: $1 is not installed"
  fi
}

step "mise self-update" mise self-update --yes
# Tools are declared only in the global config; `--global` keeps a mise.local.toml here out of it.
step "mise upgrade" mise upgrade --global
step "bootstrap packages" mise bootstrap packages upgrade
step "bootstrap repos" mise bootstrap repos update --yes
optional_step "claude update" claude update
optional_step "rustup update" rustup update
# `plugin update` rather than reviewr's documented uninstall and install: the plugin stays registered
# throughout, so a failed install cannot leave it removed. Its config lives apart and stays either way.
# A missing plugin fails here; `mise bootstrap` is what installs it.
optional_step "reviewr" herdr plugin update persiyanov.reviewr --yes

if ((${#failed[@]} > 0)); then
  printf 'failed: %s\n' "${failed[@]}" >&2
  exit 1
fi

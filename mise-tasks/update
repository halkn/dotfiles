#!/usr/bin/env bash
#MISE description="mise 本体・ツール・OS パッケージ・zsh プラグイン・Claude Code を更新"
# No `set -e`: every step is independent, so one failure must not skip the rest.
set -uo pipefail

failed=()

step() {
  local name=$1
  shift
  "$@" || failed+=("$name")
}

optional_step() {
  local name=$1
  shift
  if command -v "$1" >/dev/null; then
    step "$name" "$@"
  else
    echo "skip: $1 is not installed"
  fi
}

step "mise self-update" mise self-update --yes
# Tools are declared only in the global config; `--global` keeps a mise.local.toml here out of it.
step "mise upgrade" mise upgrade --global
step "bootstrap packages" mise bootstrap packages upgrade
step "bootstrap repos" mise bootstrap repos update --yes
optional_step "claude update" claude update
# reviewr's documented update is uninstall then install; its config is keyed by plugin id and stays.
if command -v herdr >/dev/null; then
  # The install runs even when the uninstall fails, so a plugin missing here is put back.
  step "reviewr" sh -c 'herdr plugin uninstall persiyanov.reviewr; herdr plugin install persiyanov/herdr-reviewr --yes'
else
  echo "skip: herdr is not installed"
fi

if ((${#failed[@]} > 0)); then
  printf 'failed: %s\n' "${failed[@]}" >&2
  exit 1
fi

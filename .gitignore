# snowflake-cli generated files
.config/snowflake/.cli_version.cache

# secret
.config/gh/

# machine-local zsh overrides
.config/zsh/.zshenv.local
.config/zsh/.zshrc.local

# machine-local mise overrides
.config/mise/config.local.toml
.config/mise/config.*.local.toml

# machine-local neovim overrides
.config/nvim/lua/local.lua

# machine-local git identity
.config/git/config.local

# herdr writes its runtime state (sessions, snapshots, logs, an ssh-agent
# symlink) beside config.toml and adds new files there across versions
# (herdr 0.9.3), so the tracked files are allowlisted instead.
.config/herdr/*
!.config/herdr/config.toml
!.config/herdr/*.zsh
!.config/herdr/plugins/
.config/herdr/plugins/*
!.config/herdr/plugins/config/
.config/herdr/plugins/config/*
!.config/herdr/plugins/config/persiyanov.reviewr/
.config/herdr/plugins/config/persiyanov.reviewr/*
!.config/herdr/plugins/config/persiyanov.reviewr/config.toml

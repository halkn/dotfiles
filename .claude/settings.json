{
  "permissions": {
    "allow": [
      "Bash(mise bootstrap status*)",
      "Bash(mise bootstrap plan*)",
      "Bash(mise bootstrap --dry-run*)",
      "Bash(mise bootstrap * status*)"
    ],
    "deny": [
      "Bash(mise bootstrap remote*)"
    ],
    "ask": [
      "Bash(mise run sync)",
      "Bash(mise run update)",
      "Bash(mise bootstrap --yes*)",
      "Bash(mise bootstrap -y*)",
      "Bash(mise bootstrap --force-dotfiles*)",
      "Bash(mise bootstrap * --yes*)",
      "Bash(mise bootstrap * -y*)",
      "Bash(mise bootstrap * --force-dotfiles*)",
      "Edit(/claude/**)",
      "Edit(/.config/git/**)",
      "Edit(/.config/herdr/plugins/github/**)",
      "Edit(/.config/herdr/plugins/github-installations/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        "./claude",
        "./.config/git",
        "./.config/herdr/plugins/github",
        "./.config/herdr/plugins/github-installations"
      ]
    }
  }
}
